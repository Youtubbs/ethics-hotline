DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ethics_hotline
APP_ENV=development
LOG_LEVEL=INFO

# Used by docker-compose.yml to configure the db service and to build the
# api service's DATABASE_URL against the "db" hostname on the compose
# network (overriding the value above, which is for running the app
# directly against a locally hosted Postgres).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ethics_hotline

# Region and bucket for the Comprehend, Textract and S3 calls made through
# the wrappers in src/ethics_hotline/aws/. 
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Largest evidence file accepted on a report submission, in bytes.
# Defaults to 5242880 (5 MB) when left blank.
MAX_EVIDENCE_BYTES=

# Credentials for the least-privilege IAM user.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Reference values for tagging AWS resources.
AWS_TAG_BATCH_ID=
AWS_TAG_CREATED_BY=
AWS_TAG_PURPOSE=
